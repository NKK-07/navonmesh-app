{
  "name": "navonmesh-push",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API, database and push relay for the NAVONMESH cold storage app",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "migrate": "node migrate.js",
    "migrate:status": "node migrate.js --status",
    "seed": "node seed.js",
    "provision": "node provision.js",
    "keys": "node -e \"import('web-push').then(w=>console.log(JSON.stringify(w.default.generateVAPIDKeys(),null,2)))\"",
    "test:rls": "node test-rls.js"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "web-push": "^3.6.7",
    "jsonwebtoken": "^9.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
