# ---------------------------------------------------------------- database
# This file is the LOCAL target only. Neon's connection strings live in the
# repo root .env.local, written by `neon link`, and `npm run neon:*` picks
# them up on its own. Do not paste a Neon URL in here: two files defining
# DATABASE_URL is the thing scripts/db.mjs exists to prevent.
#
# The OWNER connection. Migrations, seeding and push fan out use it. No
# request-scoped query does.
DATABASE_URL=postgres://postgres:devpass@localhost:55432/navonmesh

# The APP connection, and the one that matters. The owner role bypasses row
# level security; this one cannot. If the API runs on the owner, every farmer
# can read every other FPO. Run `npm run provision` to set this role's
# password and print this URL. For Neon, `npm run neon:provision -- --write-env`
# writes server/.env.neon instead, so the password is never copied by hand.
DATABASE_URL_APP=postgres://navonmesh_app:CHANGE_ME@localhost:55432/navonmesh

# Set to 1 only for a database presenting a self signed certificate. Neon does
# not need it; leaving it unset means the certificate is verified.
# PGSSL_INSECURE=

# ------------------------------------------------------------------ tokens
# 32 characters minimum. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
JWT_TTL=30d

# ------------------------------------------------------------------- push
# Generate once with `npm run keys`, then set BOTH here and never rotate them
# casually: new keys invalidate every phone already subscribed.
# In deployment these must be environment variables, not the vapid.json file,
# because the filesystem there is read only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:team@navonmesh.example

# ------------------------------------------------------------------ server
# Local only. The deployed API is a function and has no port.
PORT=4000
