# ---------------------------------------------------------------- database
# The OWNER connection. Migrations use it. Nothing that serves a request does.
# On Railway this is the DATABASE_URL the Postgres plugin gives you.
DATABASE_URL=postgres://postgres:devpass@localhost:55432/navonmesh

# The APP connection, and the one that matters.
# Railway's DATABASE_URL is a SUPERUSER, and superusers bypass row level
# security unconditionally. If the API runs on it, every policy is inert and
# every farmer can read every other FPO. Run `npm run provision` to set this
# role's password and print this URL.
DATABASE_URL_APP=postgres://navonmesh_app:CHANGE_ME@localhost:55432/navonmesh

# ------------------------------------------------------------------ tokens
# 32 characters minimum. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
JWT_TTL=30d

# ------------------------------------------------------------------- push
# Generate once with `npm run keys`, then set BOTH here and never rotate them
# casually: new keys invalidate every phone already subscribed.
# On Railway these must be env vars, not the vapid.json file, because the
# filesystem there is ephemeral.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:team@navonmesh.example

# ------------------------------------------------------------------ server
PORT=4000
