# ---------------------------------------------------------------- database
# The OWNER connection. Migrations, seeding and push fan out use it. No
# request-scoped query does. On Neon this is the connection string the project
# hands you, whose role owns the schema.
#
# Use Neon's POOLED string (the host with -pooler in it). Every query here runs
# inside an explicit transaction, which is exactly what transaction pooling
# supports, and serverless functions open far more connections than a direct
# endpoint will tolerate.
DATABASE_URL=postgres://postgres:devpass@localhost:55432/navonmesh

# The APP connection, and the one that matters.
# The database's own role is effectively a superuser over this schema, and an
# owner bypasses its own policies unless the table is FORCEd. If the API runs
# on it, every farmer can read every other FPO. Run `npm run provision` to set
# this role's password and print this URL.
DATABASE_URL_APP=postgres://navonmesh_app:CHANGE_ME@localhost:55432/navonmesh

# Set to 1 only for a database presenting a self signed certificate. Neon does
# not need it; leaving it unset means the certificate is verified.
# PGSSL_INSECURE=

# ------------------------------------------------------------------ tokens
# 32 characters minimum. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
JWT_TTL=30d

# ------------------------------------------------------------------- push
# Generate once with `npm run keys`, then set BOTH here and never rotate them
# casually: new keys invalidate every phone already subscribed.
# In deployment these must be environment variables, not the vapid.json file,
# because the filesystem there is read only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:team@navonmesh.example

# ------------------------------------------------------------------ server
# Local only. The deployed API is a function and has no port.
PORT=4000
